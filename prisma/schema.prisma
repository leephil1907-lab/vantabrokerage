// VANTA Markets — brokerage platform data model
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── ENUMS ─────────────────────────────
enum UserRole {
  USER
  SUPPORT
  FINANCE
  ADMIN
  SUPERADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  RESTRICTED
  SUSPENDED
  CLOSED
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum AccountType {
  LIVE
  PAPER
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum AssetClass {
  FOREX
  INDEX
  COMMODITY
  CRYPTO
}

enum MarketCategory {
  FOREX
  CFD
  BINARY
  SPOT
  FUTURES
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
  STOP
  STOP_MARKET
  TAKE_PROFIT
  TAKE_PROFIT_MARKET
}

enum OrderStatus {
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  REJECTED
  EXPIRED
}

enum PositionSide {
  LONG
  SHORT
}

enum MarginMode {
  CROSS
  ISOLATED
}

enum TradeEnv {
  LIVE
  PAPER
}

enum BinaryDirection {
  CALL
  PUT
}

enum BinaryResult {
  OPEN
  WIN
  LOSS
  DRAW
  VOID
}

enum TxType {
  DEPOSIT
  WITHDRAWAL
  TRADE_FEE
  TRADE_PNL
  BINARY_STAKE
  BINARY_SETTLEMENT
  FUNDING
  TRANSFER_IN
  TRANSFER_OUT
  REFERRAL_COMMISSION
  BONUS
  ADJUSTMENT
  LIQUIDATION
}

enum TxStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum DepositMethod {
  CRYPTO
  CARD
  BANK_TRANSFER
  INTERNAL
}

enum DepositStatus {
  PENDING
  CONFIRMING
  CREDITED
  FAILED
  REJECTED
  REFUNDED
}

enum WithdrawalStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  PROCESSING
  COMPLETED
  REJECTED
  FAILED
}

enum ReferralStatus {
  REGISTERED
  QUALIFIED
  REWARDED
  REJECTED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum TicketStatus {
  OPEN
  PENDING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AlertDirection {
  ABOVE
  BELOW
}

enum NotificationType {
  SYSTEM
  ACCOUNT
  DEPOSIT
  WITHDRAWAL
  TRADE
  SECURITY
  SUPPORT
  REFERRAL
}

enum CopyStatus {
  ACTIVE
  PAUSED
  STOPPED
}

enum MarginCallStatus {
  WARNING
  LIQUIDATED
}

// ───────────────────────────── IDENTITY ─────────────────────────────
model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String
  role            UserRole   @default(USER)
  status          UserStatus @default(PENDING)
  emailVerifiedAt DateTime?
  twoFactorSecret String?
  twoFactorEnabled Boolean   @default(false)
  referralCode    String     @unique
  referredById    String?
  referredBy      User?      @relation("Referrals", fields: [referredById], references: [id])
  referrals       User[]     @relation("Referrals")
  lastLoginAt     DateTime?
  lastLoginIp     String?
  failedAttempts  Int        @default(0)
  lockedUntil     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  profile        Profile?
  sessions       Session[]
  emailTokens    EmailToken[]
  kyc            KycRecord?
  accounts       Account[]
  notifications  Notification[]
  tickets        SupportTicket[]
  ticketMessages TicketMessage[]
  referralLinks  Referral[]
  commissions    Commission[]   @relation("CommissionBeneficiary")
  copyTrader     CopyTrader?
  copyFollowers  CopyRelationship[]
  auditLogs      AdminAuditLog[] @relation("AuditActor")
  bonuses        Bonus[]
  watchlist      WatchlistItem[]

  @@index([status])
  @@index([referredById])
  alerts          PriceAlert[]
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String?
  lastName  String?
  country   String?
  phone     String?
  dateOfBirth DateTime?
  address   String?
  city      String?
  postalCode String?
  timezone  String   @default("UTC")
  preferences Json    @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  ip         String?
  userAgent  String?
  device     String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
}

model EmailToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // VERIFY_EMAIL | RESET_PASSWORD
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, type])
}

model KycRecord {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          KycStatus @default(NOT_SUBMITTED)
  level           Int       @default(1)
  documentType    String?
  documentNumber  String?
  documentCountry String?
  fullName        String?
  dateOfBirth     DateTime?
  address         String?
  documents       Json      @default("[]")
  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedById    String?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ───────────────────────────── ACCOUNTS & WALLET ─────────────────────────────
model Account {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         AccountType   @default(LIVE)
  status       AccountStatus @default(ACTIVE)
  currency     String        @default("USD")
  leverage     Int           @default(100)
  isDefault    Boolean       @default(false)
  wallet       Wallet?
  orders       Order[]
  positions    Position[]
  binaryTrades BinaryTrade[]
  copyRelationships CopyRelationship[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([userId, type])
  @@index([userId])
}

model Wallet {
  id        String        @id @default(cuid())
  accountId String        @unique
  account   Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  currency  String        @default("USD")
  available Decimal       @default(0) @db.Decimal(28, 10)
  locked    Decimal       @default(0) @db.Decimal(28, 10)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  holdings  Holding[]
  deposits  Deposit[]
  withdrawals Withdrawal[]
  ledgerEntries LedgerEntry[]
}

model Holding {
  id       String  @id @default(cuid())
  walletId String
  wallet   Wallet  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  asset    String
  amount   Decimal @default(0) @db.Decimal(28, 10)
  locked   Decimal @default(0) @db.Decimal(28, 10)

  @@unique([walletId, asset])
}

model LedgerTransaction {
  id          String    @id @default(cuid())
  type        TxType
  status      TxStatus  @default(COMPLETED)
  reference   String?   @unique
  description String?
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())
  entries     LedgerEntry[]

  @@index([type, createdAt])
}

model LedgerEntry {
  id            String            @id @default(cuid())
  transactionId String
  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  /// Null for the platform counterparty leg of a balanced transaction.
  walletId      String?
  wallet        Wallet?           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  /// Counterparty account key, e.g. PLATFORM, PLATFORM_FEES.
  systemAccount String?
  direction     LedgerDirection
  amount        Decimal           @db.Decimal(28, 10)
  balanceAfter  Decimal           @db.Decimal(28, 10)
  createdAt     DateTime          @default(now())

  @@index([walletId, createdAt])
  @@index([transactionId])
}

model InternalTransfer {
  id           String   @id @default(cuid())
  fromWalletId String
  toWalletId   String
  amount       Decimal  @db.Decimal(28, 10)
  reference    String   @unique
  createdAt    DateTime @default(now())
}

model Deposit {
  id            String        @id @default(cuid())
  walletId      String
  wallet        Wallet        @relation(fields: [walletId], references: [id])
  method        DepositMethod
  status        DepositStatus @default(PENDING)
  asset         String
  network       String?
  address       String?
  txHash        String?       @unique
  amount        Decimal       @db.Decimal(28, 10)
  creditedAmount Decimal?     @db.Decimal(28, 10)
  confirmations Int           @default(0)
  requiredConfirmations Int   @default(3)
  provider      String?
  providerRef   String?
  idempotencyKey String?      @unique
  metadata      Json          @default("{}")
  creditedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([walletId, status])
}

model Withdrawal {
  id           String           @id @default(cuid())
  walletId     String
  wallet       Wallet           @relation(fields: [walletId], references: [id])
  status       WithdrawalStatus @default(PENDING)
  asset        String
  network      String?
  address      String
  amount       Decimal          @db.Decimal(28, 10)
  fee          Decimal          @default(0) @db.Decimal(28, 10)
  netAmount    Decimal          @db.Decimal(28, 10)
  txHash       String?
  provider     String?
  providerRef  String?
  reviewNote   String?
  reviewedById String?
  reviewedAt   DateTime?
  twoFactorVerified Boolean     @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([walletId, status])
}

// ───────────────────────────── MARKETS ─────────────────────────────
model Asset {
  id        String     @id @default(cuid())
  symbol    String     @unique
  name      String
  assetClass AssetClass
  decimals  Int        @default(2)
  logo      String?
  enabled   Boolean    @default(true)
}

model TradingPair {
  id            String         @id @default(cuid())
  symbol        String         @unique
  displayName   String
  baseAsset     String
  quoteAsset    String
  assetClass    AssetClass
  category      MarketCategory
  pricePrecision Int           @default(5)
  qtyPrecision  Int            @default(4)
  minQty        Decimal        @default(0.0001) @db.Decimal(24, 10)
  maxLeverage   Int            @default(1)
  takerFee      Decimal        @default(0.001) @db.Decimal(10, 6)
  makerFee      Decimal        @default(0.0002) @db.Decimal(10, 6)
  fundingIntervalHours Int     @default(8)
  payoutRate    Decimal?       @db.Decimal(10, 4) // short-expiry payout, e.g. 0.85
  enabled       Boolean        @default(true)
  dataSource    String         @default("yahoo")
  sourceSymbol  String?
  candles       PriceCandle[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([category, enabled])
}

model PriceCandle {
  id       String   @id @default(cuid())
  pairId   String
  pair     TradingPair @relation(fields: [pairId], references: [id], onDelete: Cascade)
  interval String
  openTime DateTime
  closeTime DateTime
  open     Decimal  @db.Decimal(24, 8)
  high     Decimal  @db.Decimal(24, 8)
  low      Decimal  @db.Decimal(24, 8)
  close    Decimal  @db.Decimal(24, 8)
  volume   Decimal  @default(0) @db.Decimal(28, 8)
  source   String   @default("provider")

  @@unique([pairId, interval, openTime])
  @@index([pairId, interval, openTime])
}

model MarketQuote {
  id        String   @id @default(cuid())
  pairId    String   @unique
  bid       Decimal  @db.Decimal(24, 8)
  ask       Decimal  @db.Decimal(24, 8)
  last      Decimal  @db.Decimal(24, 8)
  open24h   Decimal? @db.Decimal(24, 8)
  high24h   Decimal? @db.Decimal(24, 8)
  low24h    Decimal? @db.Decimal(24, 8)
  volume24h Decimal? @db.Decimal(28, 8)
  change24h Decimal? @db.Decimal(12, 6)
  spread    Decimal? @db.Decimal(24, 8)
  source    String
  fetchedAt DateTime @default(now())

  @@index([fetchedAt])
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol    String
  createdAt DateTime @default(now())

  @@unique([userId, symbol])
}

// ───────────────────────────── TRADING ─────────────────────────────
model Order {
  id           String      @id @default(cuid())
  accountId    String
  account      Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  pairId       String
  symbol       String
  category     MarketCategory
  side         OrderSide
  type         OrderType
  status       OrderStatus @default(OPEN)
  qty          Decimal     @db.Decimal(24, 10)
  price        Decimal?    @db.Decimal(24, 10)
  stopPrice    Decimal?    @db.Decimal(24, 10)
  takeProfit   Decimal?    @db.Decimal(24, 10)
  stopLoss     Decimal?    @db.Decimal(24, 10)
  filledQty    Decimal     @default(0) @db.Decimal(24, 10)
  avgFillPrice Decimal?    @db.Decimal(24, 10)
  leverage     Int         @default(1)
  marginMode   MarginMode  @default(CROSS)
  reduceOnly   Boolean     @default(false)
  reserved     Decimal     @default(0) @db.Decimal(28, 10)
  fee          Decimal     @default(0) @db.Decimal(28, 10)
  rejectReason String?
  clientOrderId String?
  expiresAt    DateTime?
  filledAt     DateTime?
  cancelledAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  fills        Execution[]
  position     Position?

  @@index([accountId, status])
  @@index([symbol, createdAt])
}

model Execution {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  qty        Decimal  @db.Decimal(24, 10)
  price      Decimal  @db.Decimal(24, 10)
  fee        Decimal  @default(0) @db.Decimal(28, 10)
  venue      String   @default("internal")
  venueRef   String?
  quoteTs    DateTime
  createdAt  DateTime @default(now())

  @@index([orderId])
}

model Position {
  id            String       @id @default(cuid())
  accountId     String
  account       Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  orderId       String?      @unique
  order         Order?       @relation(fields: [orderId], references: [id])
  pairId        String
  symbol        String
  category      MarketCategory
  side          PositionSide
  qty           Decimal      @db.Decimal(24, 10)
  entryPrice    Decimal      @db.Decimal(24, 10)
  markPrice     Decimal?     @db.Decimal(24, 10)
  leverage      Int          @default(1)
  marginMode    MarginMode   @default(CROSS)
  isolatedMargin Decimal?    @db.Decimal(28, 10)
  initialMargin Decimal      @db.Decimal(28, 10)
  liquidationPrice Decimal?  @db.Decimal(24, 10)
  takeProfit    Decimal?     @db.Decimal(24, 10)
  stopLoss      Decimal?     @db.Decimal(24, 10)
  unrealizedPnl Decimal      @default(0) @db.Decimal(28, 10)
  realizedPnl   Decimal      @default(0) @db.Decimal(28, 10)
  feesPaid      Decimal      @default(0) @db.Decimal(28, 10)
  fundingPaid   Decimal      @default(0) @db.Decimal(28, 10)
  status        String       @default("OPEN") // OPEN | CLOSED
  closedAt      DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([accountId, status])
  @@index([symbol, status])
}

model BinaryTrade {
  id             String          @id @default(cuid())
  accountId      String
  account        Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  symbol         String
  pairId         String
  direction      BinaryDirection
  stake          Decimal         @db.Decimal(28, 10)
  payoutRate     Decimal         @db.Decimal(10, 4)
  entryPrice     Decimal         @db.Decimal(24, 10)
  settlePrice    Decimal?        @db.Decimal(24, 10)
  result         BinaryResult    @default(OPEN)
  pnl            Decimal         @default(0) @db.Decimal(28, 10)
  expiresAt      DateTime
  settledAt      DateTime?
  entryQuoteTs   DateTime
  exitQuoteTs    DateTime?
  priceFeed      String
  env            TradeEnv        @default(PAPER)
  createdAt      DateTime        @default(now())

  @@index([accountId, result])
  @@index([result, expiresAt])
}

model FundingPayment {
  id         String   @id @default(cuid())
  positionId String
  accountId  String
  symbol     String
  rate       Decimal  @db.Decimal(12, 8)
  amount     Decimal  @db.Decimal(28, 10)
  markPrice  Decimal  @db.Decimal(24, 10)
  fundingTime DateTime
  createdAt  DateTime @default(now())

  @@index([accountId, fundingTime])
}

model LiquidationEvent {
  id         String   @id @default(cuid())
  positionId String
  accountId  String
  symbol     String
  side       PositionSide
  qty        Decimal  @db.Decimal(24, 10)
  price      Decimal  @db.Decimal(24, 10)
  bankruptPrice Decimal @db.Decimal(24, 10)
  lossAmount Decimal  @db.Decimal(28, 10)
  createdAt  DateTime @default(now())

  @@index([accountId, createdAt])
}

model MarginRecord {
  id         String   @id @default(cuid())
  accountId  String
  positionId String?
  symbol     String
  ratio      Decimal  @db.Decimal(12, 6)
  status     MarginCallStatus
  equity     Decimal  @db.Decimal(28, 10)
  maintenance Decimal @db.Decimal(28, 10)
  createdAt  DateTime @default(now())

  @@index([accountId, createdAt])
}

// ───────────────────────────── COPY TRADING ─────────────────────────────
model CopyTrader {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String
  strategy        String
  bio             String?
  verified        Boolean  @default(false)
  riskLevel       String   @default("MEDIUM")
  followerCount   Int      @default(0)
  totalTrades     Int      @default(0)
  winRate         Decimal  @default(0) @db.Decimal(6, 4)
  roi30d          Decimal  @default(0) @db.Decimal(12, 4)
  maxDrawdown     Decimal  @default(0) @db.Decimal(12, 4)
  followers       CopyRelationship[]
  createdAt       DateTime @default(now())
}

model CopyRelationship {
  id               String     @id @default(cuid())
  followerId       String
  follower         User       @relation(fields: [followerId], references: [id], onDelete: Cascade)
  copyTraderId     String
  copyTrader       CopyTrader @relation(fields: [copyTraderId], references: [id], onDelete: Cascade)
  accountId        String
  account          Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  allocation       Decimal    @db.Decimal(28, 10)
  maxExposure      Decimal    @db.Decimal(28, 10)
  status           CopyStatus @default(ACTIVE)
  realizedPnl      Decimal    @default(0) @db.Decimal(28, 10)
  createdAt        DateTime   @default(now())
  stoppedAt        DateTime?

  @@unique([followerId, copyTraderId])
}

// ───────────────────────────── REFERRALS ─────────────────────────────
model Referral {
  id          String         @id @default(cuid())
  referrerId  String
  referrer    User           @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  refereeEmail String
  refereeUserId String?
  status      ReferralStatus @default(REGISTERED)
  qualifiedAt DateTime?
  createdAt   DateTime       @default(now())

  @@unique([referrerId, refereeEmail])
  @@index([referrerId])
}

model Commission {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation("CommissionBeneficiary", fields: [userId], references: [id], onDelete: Cascade)
  amount       Decimal          @db.Decimal(28, 10)
  rate         Decimal          @db.Decimal(10, 6)
  sourceType   String
  sourceTxId   String?
  status       CommissionStatus @default(PENDING)
  createdAt    DateTime         @default(now())
  approvedAt   DateTime?
  paidAt       DateTime?

  @@index([userId, status])
}

model Bonus {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  amount    Decimal  @db.Decimal(28, 10)
  turnoverRequired Decimal @db.Decimal(28, 10)
  turnoverDone Decimal @default(0) @db.Decimal(28, 10)
  status    String   @default("ACTIVE")
  expiresAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId, status])
}

// ───────────────────────────── ENGAGEMENT ─────────────────────────────
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType @default(SYSTEM)
  title     String
  body      String
  href      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read, createdAt])
}

model SupportTicket {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  category  String
  priority  TicketPriority @default(NORMAL)
  status    TicketStatus   @default(OPEN)
  assignedToId String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  messages  TicketMessage[]

  @@index([status, priority])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  isStaff   Boolean  @default(false)
  attachments Json   @default("[]")
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

model SystemConfig {
  key       String   @id
  value     Json
  category  String   @default("general")
  updatedById String?
  updatedAt DateTime @updatedAt
}

model RateLimitBucket {
  id        String   @id @default(cuid())
  key       String
  window    DateTime
  count     Int      @default(0)

  @@unique([key, window])
}

model JobRun {
  id        String   @id @default(cuid())
  name      String
  status    String
  detail    String?
  startedAt DateTime @default(now())
  finishedAt DateTime?

  @@index([name, startedAt])
}

model EmailOutbox {
  id        String   @id @default(cuid())
  to        String
  subject   String
  body      String
  template  String   @default("generic")
  status    String   @default("QUEUED") // QUEUED | SENT | FAILED
  error     String?
  createdAt DateTime @default(now())
  sentAt    DateTime?

  @@index([status, createdAt])
}

model PriceAlert {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol      String
  direction   AlertDirection
  threshold   Decimal        @db.Decimal(24, 10)
  triggered   Boolean        @default(false)
  triggeredAt DateTime?
  createdAt   DateTime       @default(now())

  @@index([userId])
  @@index([triggered, symbol])
}

enum ChatStatus {
  OPEN
  CLOSED
}

enum ChatSender {
  VISITOR
  AGENT
  BOT
}

model ChatSession {
  id           String        @id @default(cuid())
  visitorToken String        @unique
  displayName  String?
  contact      String?
  status       ChatStatus    @default(OPEN)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  messages     ChatMessage[]

  @@index([status, updatedAt])
}

model ChatMessage {
  id        String      @id @default(cuid())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  sender    ChatSender
  body      String
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
}
