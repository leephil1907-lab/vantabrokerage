# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/vanta?schema=public"

# Hosted deployment is managed through Render; see docs/RENDER-DEPLOYMENT.md.
# Never use these local defaults in a hosted environment.
# ── App ─────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
SESSION_SECRET="replace-with-a-64-char-random-string"

# ── Execution / market data ─────────────────────────────────────────────────
# Live order execution is disabled. Crypto deposit submissions are pending
# until finance independently verifies and manually approves them.
MARKET_DATA_MODE="live"

# Deposit addresses are seeded into funding.depositAddresses in PostgreSQL.
# Edit them through Admin > Platform settings; do not store wallet changes here.

# Optional CoinGecko Demo API key (server-side; never exposed to the browser).
COINGECKO_DEMO_API_KEY=""

# ── Optional integrations ───────────────────────────────────────────────────
ETHERSCAN_API_KEY=""
TRONGRID_API_KEY=""
CUSTODY_PROVIDER=""
PAYMENT_PROVIDER=""
KYC_PROVIDER=""
EMAIL_PROVIDER=""
REDIS_URL=""

# ── Email delivery (see docs/TRANSACTIONAL-EMAIL.md; no retry worker) ──────
# EMAIL_PROVIDER="resend"
# RESEND_API_KEY=""
# EMAIL_FROM=""
# Or EMAIL_PROVIDER="webhook" with EMAIL_WEBHOOK_URL.

# ── Seed / bootstrap (used by prisma/seed.ts only) ──────────────────────────
SEED_ADMIN_EMAIL="admin@vantamarkets.com"
SEED_ADMIN_PASSWORD="Vanta!Admin2026"

# Optional editorial news provider (server-side; never exposed to the browser).
FINNHUB_API_KEY=""
