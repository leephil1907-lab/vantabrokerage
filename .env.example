# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/vanta?schema=public"

# For Vercel review setup see docs/VERCEL-REVIEW-DEPLOYMENT.md.
# Never use these local defaults in a hosted environment.
# ── App ─────────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
SESSION_SECRET="replace-with-a-64-char-random-string"

# ── Execution / market data ─────────────────────────────────────────────────
# paper  = orders filled internally against live market data (default)
# live   = NOT implemented; live-account orders are always blocked
EXECUTION_MODE="paper"
MARKET_DATA_MODE="live"
# Legacy setting: this is NOT currently a server-side paper-trading kill switch.
ENABLE_PAPER_TRADING="true"
# Set to 0 in a protected review; does not disable existing simulation code.
PAPER_STARTING_BALANCE="0"
NEXT_PUBLIC_EXECUTION_LABEL="Paper"

# ── Deposit addresses (customer deposits are disabled; leave empty) ─────────
CRYPTO_DEPOSIT_ADDRESSES="{}"

# Optional CoinGecko Demo API key (server-side; never exposed to the browser).
COINGECKO_DEMO_API_KEY=""

# ── Optional integrations ───────────────────────────────────────────────────
ETHERSCAN_API_KEY=""
TRONGRID_API_KEY=""
CUSTODY_PROVIDER=""
PAYMENT_PROVIDER=""
KYC_PROVIDER=""
EMAIL_PROVIDER=""
REDIS_URL=""

# ── Email delivery (no SMTP worker is implemented) ─────────────────────────
# EMAIL_PROVIDER="resend"
# RESEND_API_KEY=""
# EMAIL_FROM=""
# Or EMAIL_PROVIDER="webhook" with EMAIL_WEBHOOK_URL.

# ── Seed / bootstrap (used by prisma/seed.ts only) ──────────────────────────
SEED_ADMIN_EMAIL="admin@vantamarkets.com"
SEED_ADMIN_PASSWORD="Vanta!Admin2026"
