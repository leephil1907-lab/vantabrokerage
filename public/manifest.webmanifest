{
  "id": "/",
  "name": "PRIMEVEST — Multi-asset brokerage terminal",
  "short_name": "PRIMEVEST",
  "description": "Forex, CFDs, short-expiry, crypto spot and perpetual futures in one multi-asset terminal with a unified wallet and full portfolio accounting.",
  "lang": "en",
  "dir": "ltr",
  "categories": ["finance", "business", "productivity"],
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0a0e16",
  "theme_color": "#0a0e16",
  "handle_links": "preferred",
  "prefer_related_applications": false,
  "related_applications": [],
  "launch_handler": { "client_mode": ["navigate-existing", "auto-client"] },
  "edge_side_panel": { "preferred_width": 420 },
  "icons": [
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-192-maskable.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon-192-mono.png", "sizes": "192x192", "type": "image/png", "purpose": "monochrome" },
    { "src": "/icon-512-mono.png", "sizes": "512x512", "type": "image/png", "purpose": "monochrome" }
  ],
  "screenshots": [
    { "src": "/screenshots/desktop-wide.png", "sizes": "1280x800", "type": "image/png", "form_factor": "wide", "label": "PRIMEVEST markets desk with live quotes, heatmap and sessions" },
    { "src": "/screenshots/mobile-narrow.png", "sizes": "780x1688", "type": "image/png", "form_factor": "narrow", "label": "PRIMEVEST home on mobile" }
  ],
  "shortcuts": [
    { "name": "Terminal", "short_name": "Terminal", "description": "Open the trading terminal desk", "url": "/dashboard/trade", "icons": [{ "src": "/shortcuts/terminal-96.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Markets", "short_name": "Markets", "description": "Live markets, heatmap and movers", "url": "/markets", "icons": [{ "src": "/shortcuts/markets-96.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Dashboard", "short_name": "Dashboard", "description": "Portfolio, wallet and performance", "url": "/dashboard", "icons": [{ "src": "/shortcuts/dashboard-96.png", "sizes": "96x96", "type": "image/png" }] }
  ],
  "share_target": {
    "action": "/dashboard/trade",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": { "text": "symbol", "url": "source" }
  },
  "protocol_handlers": [
    { "protocol": "web+primevest", "url": "/dashboard/trade?symbol=%s" }
  ],
  "file_handlers": [
    { "action": "/open-file", "accept": { "text/csv": [".csv"], "application/json": [".json"] } }
  ]
}
