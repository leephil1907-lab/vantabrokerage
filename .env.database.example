# Managed PostgreSQL connection variables for Prisma
# Replace placeholders with the exact connection strings from your provider.
# DATABASE_URL should be the pooled URL used by the Next.js runtime.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/DATABASE?sslmode=require&pgbouncer=true"

# DIRECT_URL should be the direct, non-pooled URL used by Prisma Migrate.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require"

# For local PostgreSQL, both variables can use the same direct connection URL.
